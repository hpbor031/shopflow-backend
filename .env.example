# ==================== MySQL 配置 ====================
# 本地运行：MYSQL_HOST=localhost，MYSQL_USER 填本地 MySQL 账号（如 root）
# Docker 部署：MYSQL_HOST=mysql（Compose 里的服务名），MYSQL_USER=shopflow_user
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD='你的MySQL密码'
MYSQL_DATABASE=ShopFlow

# 仅 Docker 部署需要：MySQL 容器的 root 密码，compose.yaml 用它初始化数据库并做健康检查
# 注意：数据卷首次初始化后该变量不再生效，改密码需重建数据卷（docker compose down -v）
MYSQL_ROOT_PASSWORD='你的MySQL root密码'

# JWT 密钥：复制本文件为 .env 后，用下面的命令生成一个随机值填进来
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY='你的JWT密钥'
# access_token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== Redis 商品缓存 ====================
# 本地运行：REDIS_HOST=127.0.0.1（Windows 下避免 localhost 优先解析到 IPv6）
# Docker Compose：compose.yaml 会把应用容器的 REDIS_HOST 覆盖为 redis
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 本地开发默认不设置密码；连接带认证的外部 Redis 时填写
REDIS_PASSWORD=
# 商品缓存有效期（秒）
REDIS_CACHE_TTL_SECONDS=300
# Redis 连接和读写超时（秒），超时后自动回落 MySQL
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
