# ==================== MySQL 配置 ====================
# 本地运行：MYSQL_HOST=localhost，MYSQL_USER 填本地 MySQL 账号（如 root）
# Docker 部署：MYSQL_HOST=mysql（Compose 里的服务名），MYSQL_USER=shopflow_user
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD='你的MySQL密码'
MYSQL_DATABASE=ShopFlow

# 仅 Docker 部署需要：MySQL 容器的 root 密码，compose.yaml 用它初始化数据库并做健康检查
# 注意：数据卷首次初始化后该变量不再生效，改密码需重建数据卷（docker compose down -v）
MYSQL_ROOT_PASSWORD='你的MySQL root密码'

# JWT 密钥：复制本文件为 .env 后，用下面的命令生成一个随机值填进来
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY='你的JWT密钥'
# access_token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60