# ==================== 环境变量文件 ====================
# .env 里放着 MySQL 密码和 JWT 密钥，一旦提交就等于泄露，必须忽略
.env
.env.*
# 但模板文件要保留在版本库里，供其他人复制出 .env
!.env.example

# ==================== 虚拟环境 ====================
.venv/
venv/
env/
ENV/

# ==================== Python 字节码与缓存 ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==================== 打包 / 构建产物 ====================
build/
dist/
*.egg-info/
*.egg

# ==================== IDE / 编辑器 ====================
.idea/
.vscode/
*.swp
*.swo

# ==================== 日志与本地数据库文件 ====================
*.log
logs/
*.sqlite3
*.db

# ==================== 操作系统产生的文件 ====================
Thumbs.db
Desktop.ini
.DS_Store